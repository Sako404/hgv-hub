# Copy to .env and fill in real values before running
# `docker compose up -d`. See docs/BACKEND_SELF_HOSTING.md.

# Postgres
POSTGRES_DB=workingtime
POSTGRES_USER=workingtime
POSTGRES_PASSWORD=change-me

# Host ports (change if they clash with something else on your machine)
SERVER_PORT=3001
CLIENT_PORT=8080

# The client is a static build with the API URL baked in at build
# time — if you change this, run `docker compose build client` again,
# a restart alone won't pick it up. Use the address other devices on
# your network will actually reach this server at (not "localhost")
# if you want to use the app from more than one device.
VITE_API_BASE_URL=http://localhost:3001

# Must match VITE_API_BASE_URL's origin (or a comma-separated list of
# every origin you'll load the client from) — the server rejects
# cross-origin requests from anywhere not listed here.
CORS_ORIGIN=http://localhost:8080

# Leave false unless this is genuinely served over HTTPS (e.g. behind
# a reverse proxy with a real certificate). A Secure session cookie is
# silently never sent back by the browser over plain HTTP — turning
# this on for a plain-HTTP LAN deployment breaks login entirely (it
# appears to succeed, then every next request looks signed out).
COOKIE_SECURE=false

# The self-update feature's updater service needs to run `docker
# compose` against your real Docker daemon via the mounted socket —
# for that to resolve paths correctly, this MUST be the exact absolute
# path where you cloned this repo ON THE HOST (not inside any
# container). E.g. /home/youruser/hgv-hub. Get it wrong and updates
# will fail with a "no such file or directory" from the updater
# container, not silently do the wrong thing.
REPO_HOST_PATH=/absolute/path/to/this/checkout/on/the/host

# Leave blank for a plain `docker compose up` deployment (the default
# project name, derived from this directory's name, already matches).
# REQUIRED if you deployed via TrueNAS's "Custom App" system (or
# anything else that runs docker compose under a different project
# name than this directory) — set it to that actual project name (for
# TrueNAS Custom Apps, that's "ix-<app_name>", e.g. "ix-hgv-hub"). Get
# this wrong and self-update creates a second, competing stack instead
# of updating the real one — see docs/BACKEND_SELF_HOSTING.md.
COMPOSE_PROJECT_NAME=
